ASTER_OS_OP(void *, alloc, (size_t bytes,unsigned region), (bytes,region), ptr)
ASTER_OS_OP(void, free, (void *memory,unsigned region), (memory,region), void)
ASTER_OS_OP(uint64_t, uptime_ms, (void), (), u64)
ASTER_OS_OP(uint32_t, cycle_us, (void), (), u32)
ASTER_OS_OP(void, sleep_ms, (uint32_t milliseconds), (milliseconds), void)
ASTER_OS_OP(int, wall_clock, (aster_time_info_t *out), (out), status)
ASTER_OS_OP(int, file_open, (aster_os_file_t *file,const char *path,unsigned flags), (file,path,flags), status)
ASTER_OS_OP(int, file_close, (aster_os_file_t *file), (file), status)
ASTER_OS_OP(int, file_read, (aster_os_file_t *file,void *data,size_t bytes), (file,data,bytes), status)
ASTER_OS_OP(int, file_write, (aster_os_file_t *file,const void *data,size_t bytes), (file,data,bytes), status)
ASTER_OS_OP(int, file_seek, (aster_os_file_t *file,int64_t offset,unsigned whence), (file,offset,whence), status)
ASTER_OS_OP(int, file_sync, (aster_os_file_t *file), (file), status)
ASTER_OS_OP(int, stat, (const char *path,aster_os_entry_t *entry), (path,entry), status)
ASTER_OS_OP(int, volume, (const char *path,aster_os_volume_t *volume), (path,volume), status)
ASTER_OS_OP(int, dir_open, (aster_os_dir_t *dir,const char *path), (dir,path), status)
ASTER_OS_OP(int, dir_read, (aster_os_dir_t *dir,aster_os_entry_t *entry), (dir,entry), status)
ASTER_OS_OP(int, dir_close, (aster_os_dir_t *dir), (dir), status)
ASTER_OS_OP(int, mkdir, (const char *path), (path), status)
ASTER_OS_OP(int, unlink, (const char *path), (path), status)
ASTER_OS_OP(int, rename, (const char *from,const char *to), (from,to), status)
ASTER_OS_OP(int, mutex_create, (aster_os_mutex_t *mutex), (mutex), status)
ASTER_OS_OP(int, mutex_lock, (aster_os_mutex_t *mutex,uint32_t timeout_ms), (mutex,timeout_ms), status)
ASTER_OS_OP(int, mutex_unlock, (aster_os_mutex_t *mutex), (mutex), status)
ASTER_OS_OP(int, mutex_destroy, (aster_os_mutex_t *mutex), (mutex), status)
ASTER_OS_OP(int, sem_create, (aster_os_sem_t *sem,unsigned initial,unsigned limit), (sem,initial,limit), status)
ASTER_OS_OP(int, sem_take, (aster_os_sem_t *sem,uint32_t timeout_ms), (sem,timeout_ms), status)
ASTER_OS_OP(int, sem_give, (aster_os_sem_t *sem), (sem), status)
ASTER_OS_OP(int, sem_destroy, (aster_os_sem_t *sem), (sem), status)
ASTER_OS_OP(int, task_start, (aster_os_task_t *task,const aster_os_task_config_t *config,aster_os_task_fn entry,void *context), (task,config,entry,context), status)
